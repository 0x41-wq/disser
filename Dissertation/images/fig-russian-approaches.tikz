\begin{tikzpicture}[
    node distance=1.0cm,
    level/.style={rectangle, draw=black, fill=blue!10, minimum width=4cm, minimum height=0.9cm, align=center, font=\small}
]

\node[level] (eremeev) {Eremeev (2003)\\Конечные автоматы\\(статика)};
\node[level, below=of eremeev] (smirnov) {Smirnov (2022)\\Тактические цепочки\\(описательно)};
\node[level, below=of smirnov] (izergin) {Izergin (2024)\\Графы процессов\\(аномалии)};
