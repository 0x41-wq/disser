# Makefile.article — сборка одной статьи
# Использует настройки из корневого Makefile

# Исходный файл
SOURCE = main
# Целевой PDF
TARGET = $(ARTICLE_NAME)

# Используем глобальный latexmkrc и BACKEND
MKRC ?= ../latexmkrc

# Компиляция статьи
.PHONY: all
all:
	cd $(ARTICLE_DIR) && \
	latexmk -norc -r $(MKRC) $(LATEXMKFLAGS) $(BACKEND) -jobname=$(TARGET) "$(SOURCE).tex"

.PHONY: clean-article
clean-article:
	cd $(ARTICLE_DIR) && \
	latexmk -norc -r $(MKRC) $(LATEXMKFLAGS) $(BACKEND) -jobname=$(TARGET) -c "$(SOURCE).tex"

# Полная очистка (включая PDF)
.PHONY: distclean-article
distclean-article:
	cd $(ARTICLE_DIR) && \
	latexmk -norc -r $(MKRC) $(LATEXMKFLAGS) $(BACKEND) -jobname=$(TARGET) -C "$(SOURCE).tex"